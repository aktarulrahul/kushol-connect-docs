#=========================================================================#
# Kushol Connect — kusholconnect.com (HTTPS)                              #
# /api/ → api container (same origin: session cookie stays host-only)     #
# /     → web container (Next.js standalone)                              #
# Source: kushol-connect-api deploy/hestia/templates (15 OPS-BE-006).     #
# Installed by deploy/hestia/setup-web.sh — edit the repo copy and rerun. #
#=========================================================================#

server {
	listen      %ip%:@HTTPS_PORT@ ssl;
	server_name %domain_idn% %alias_idn%;
	access_log  /var/log/%web_system%/domains/%domain%.log combined;
	access_log  /var/log/%web_system%/domains/%domain%.bytes bytes;
	error_log   /var/log/%web_system%/domains/%domain%.error.log error;

	ssl_certificate     %ssl_pem%;
	ssl_certificate_key %ssl_key%;

	# TLS 1.3 early data can be replayed: never pass it to the apps.
	if ($ssl_early_data) { return 425; }

	# HSTS for the locations below that add no headers of their own (/api/).
	include %home%/%user%/conf/web/%domain%/nginx.hsts.conf*;

	client_max_body_size 2m;


	# Maintenance mode (OPS-BE-015): the flag file turns every web route into the static
	# bn/en page; /api/ stays up for the api's own health gating. ops/maintenance.sh on|off.
	set $maintenance 0;
	if (-f /opt/kushol/state/maintenance.flag) { set $maintenance 1; }
	if ($maintenance = 1) { return 503; }
	error_page 503 @maintenance;
	location @maintenance {
		default_type text/html;
		add_header Cache-Control "no-store" always;
		return 503 '<!doctype html><html lang="bn"><head><meta charset="utf-8"><title>রক্ষণাবেক্ষণ | Maintenance</title></head><body style="font-family:sans-serif;text-align:center;padding:4rem"><h1>সাময়িক রক্ষণাবেক্ষণ</h1><p>আমরা খুব শীঘ্রই ফিরে আসছি।</p><hr><p style="color:#666">Scheduled maintenance — we will be back shortly.</p></body></html>';
	}

	location ~ /\.(?!well-known\/) {
		deny all;
		return 404;
	}

	# Attachment upload (05, owner 2026-10-18): the client streams the file to the api, which streams
	# it on to R2. Only this route takes more than 2 MB: 21 MB covers the largest kind's 20 MB cap
	# (the api enforces each kind's cap and sniffs the bytes). Not spooled to disk here, and the
	# read timeout covers the api's 10-minute upload window for slow mobile links.
	location = /api/v1/media/upload {
		client_max_body_size    21m;
		proxy_request_buffering off;
		proxy_pass         http://127.0.0.1:@API_PORT@;
		proxy_http_version 1.1;
		proxy_set_header   Connection        "";
		proxy_set_header   Host              $host;
		proxy_set_header   X-Real-IP         $remote_addr;
		# Overwrite, never append: the api trusts this header from Nginx only (F9/F19).
		proxy_set_header   X-Forwarded-For   $remote_addr;
		proxy_set_header   X-Forwarded-Proto $scheme;
		proxy_read_timeout 660s;
	}

	# Profile photo upload (03 · owner 2026-10-20): the photo streams to the api, which checks it
	# and stores it in R2. The api caps it at 10 MB; the 2 MB server default made larger phone
	# photos fail with 413, so nobody else ever saw them.
	location = /api/v1/me/avatar {
		client_max_body_size    11m;
		proxy_request_buffering off;
		proxy_pass         http://127.0.0.1:@API_PORT@;
		proxy_http_version 1.1;
		proxy_set_header   Connection        "";
		proxy_set_header   Host              $host;
		proxy_set_header   X-Real-IP         $remote_addr;
		# Overwrite, never append: the api trusts this header from Nginx only (F9/F19).
		proxy_set_header   X-Forwarded-For   $remote_addr;
		proxy_set_header   X-Forwarded-Proto $scheme;
		proxy_read_timeout 360s;
	}

	# Chat gateway (05) at the contract path GET /api/v1/ws; 300 s idle is plenty.
	# The session token travels in the query string or session cookie, so this route is not access-logged.
	location = /api/v1/ws {
		access_log off;
		proxy_pass         http://127.0.0.1:@API_PORT@;
		proxy_http_version 1.1;
		proxy_set_header   Upgrade           $http_upgrade;
		proxy_set_header   Connection        "upgrade";
		proxy_set_header   Host              $host;
		proxy_set_header   X-Real-IP         $remote_addr;
		proxy_set_header   X-Forwarded-For   $remote_addr;
		proxy_set_header   X-Forwarded-Proto $scheme;
		proxy_read_timeout 300s;
		proxy_send_timeout 300s;
	}

	# The api sets its own security headers (01 httpx); Nginx adds none here.
	location /api/ {
		proxy_pass         http://127.0.0.1:@API_PORT@;
		proxy_http_version 1.1;
		proxy_set_header   Connection        "";
		proxy_set_header   Host              $host;
		proxy_set_header   X-Real-IP         $remote_addr;
		# Overwrite, never append: the api trusts this header from Nginx only (F9/F19).
		proxy_set_header   X-Forwarded-For   $remote_addr;
		proxy_set_header   X-Forwarded-Proto $scheme;
	}

	location / {
		proxy_pass         http://127.0.0.1:@WEB_PORT@;
		proxy_http_version 1.1;
		proxy_set_header   Connection        "";
		proxy_set_header   Host              $host;
		proxy_set_header   X-Real-IP         $remote_addr;
		proxy_set_header   X-Forwarded-For   $remote_addr;
		proxy_set_header   X-Forwarded-Proto $scheme;
		proxy_set_header   X-Forwarded-Host  $host;

		# add_header here stops server-level headers being inherited, so HSTS is repeated.
		# A Content-Security-Policy arrives with module 07 (15 08-gaps.md G-5).
		add_header Strict-Transport-Security "max-age=31536000" always;
		add_header X-Content-Type-Options    "nosniff" always;
		add_header X-Frame-Options           "SAMEORIGIN" always;
		add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
	}

	include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
