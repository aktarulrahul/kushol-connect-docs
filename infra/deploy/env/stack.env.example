# Kushol Connect stack settings (copied to /opt/kushol/env/stack.env). Read by compose.yaml for
# interpolation and by the ops/ and hestia/ scripts. No secrets here.

# Label recorded in state/releases.log; ops/deploy.sh <env> must match it. One stack on this box:
# the pilot is promoted to prod, never run side by side (OPS-BR-004).
KUSHOL_ENV=pilot

# Images: one PRIVATE Docker Hub repository for both, told apart by a tag prefix — the owner pushes
# airahul/ai:api-main-<sha7> and airahul/ai:web-main-<sha7> (docs/images.md §2). ops/deploy.sh takes
# the plain tags (api=main-<sha7> web=main-<sha7>); Compose adds the prefix.
API_IMAGE=docker.io/airahul/ai
API_TAG_PREFIX=api-
WEB_IMAGE=docker.io/airahul/ai
WEB_TAG_PREFIX=web-

# Loopback ports Nginx proxies to. Confirm they are free with `ss -tlnp` (host/prepare-host.sh).
API_PORT=8180
WEB_PORT=3100

# Fixed Compose subnet (TRUSTED_PROXIES uses it). Outside Docker's default 172.17–31/192.168 pools.
KUSHOL_SUBNET=10.201.0.0/24

# Public names (HestiaCP web domains + smoke checks).
SITE_DOMAIN=kusholconnect.com
API_DOMAIN=api.kusholconnect.com
PUBLIC_IP=72.61.114.20
# Exim also sends over IPv6, so SPF lists it (hestia/setup-mail.sh). No AAAA records for the web
# names: HestiaCP's Nginx vhosts listen on IPv4 only.
PUBLIC_IP6=2a02:4780:5e:99d7::1

# HestiaCP user that owns the web and mail domains (created by hestia/setup-web.sh if missing).
HESTIA_USER=kusholconnect

# Post-deploy smoke: "public" goes through DNS + Nginx + TLS (the real front door, OPS-E2E-001);
# "local" checks the loopback ports only — use it until DNS points here and certificates exist.
SMOKE_MODE=local
