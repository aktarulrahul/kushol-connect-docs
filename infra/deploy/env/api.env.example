# Kushol Connect api + worker — server environment (copied to /opt/kushol/env/api.env, chmod 600).
# Parsed only by internal/config (FND-BR-002); every key there appears here or in compose.yaml
# (checked by deploy/tests/run.sh, OPS-UT-002). Uncommented keys are REQUIRED: ops/deploy.sh
# refuses to deploy while one is empty or still holds a placeholder. Never commit the real file.
#
# Set by compose.yaml (container wiring) — do not set here: HTTP_PORT, REDIS_URL, TRUSTED_PROXIES.

APP_ENV=production
LOG_LEVEL=info

# Neon project kushol-connect-db, branch production — the DIRECT (unpooled) connection string:
# golang-migrate's advisory lock (migrate-status, owner-run migrations) does not work through the
# pooler. Neon console → Connect → turn "Connection pooling" off → copy.
DATABASE_URL=postgres://USER:PASSWORD@ep-REPLACE.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 03-identity-access secrets — generate on the server: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
OTP_PEPPER=REPLACE_WITH_openssl_rand_base64_48

# --- Optional (defaults shown) ---
#SHUTDOWN_TIMEOUT=20s
#WORKER_CONCURRENCY=2
#AUTH_ACCESS_TTL=15m
#AUTH_REFRESH_TTL=720h
#AUTH_SESSION_TTL=720h
#VERIFICATION_SLA_HOURS=48
#OTP_RESEND_COOLDOWN=60s
#OTP_HOURLY_CAP_PER_TARGET=5
#OTP_HOURLY_CAP_PER_IP=200
#OTP_MAX_ATTEMPTS=3

# Mail from noreply@kusholconnect.com through HestiaCP's Exim on this server (unset = email OTP
# jobs fail degraded). The password is in the file deploy/hestia/setup-mail.sh wrote under /root.
SMTP_HOST=mail.kusholconnect.com
SMTP_PORT=587
SMTP_USERNAME=noreply@kusholconnect.com
SMTP_PASSWORD=NKC@2610$mr2#
SMTP_FROM=noreply@kusholconnect.com

# SMS gateway — TODO: Confirm vendor (unset = SMS OTP jobs fail degraded).
#SMS_GATEWAY_URL=
#SMS_GATEWAY_API_KEY=
#SMS_GATEWAY_SENDER=

# SSO (unset provider = its start redirect returns an error parameter; phone OTP keeps working).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Cloudflare R2 media (05; unset = media endpoints answer 501).
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_KEY=
#R2_BUCKET=

# Firebase push (06; unset = push degrades to in-app). The JSON must be on ONE line.
#FCM_PROJECT_ID=
#FCM_SERVICE_ACCOUNT_JSON=

# One-off Super Admin bootstrap (`api bootstrap-super-admin`); remove after use.
#BOOTSTRAP_SUPER_ADMIN_EMAIL=
#BOOTSTRAP_SUPER_ADMIN_PASSWORD=
#BOOTSTRAP_SUPER_ADMIN_PHONE=

# 12 · sandbox gateway HMAC secret (server-side only; real gateways per the 12 cutover list)
PAYMENTS_WEBHOOK_SECRET=REPLACE

# 14 · base64(32 bytes) AES-256-GCM key for ERP webhook secrets — `openssl rand -base64 32`
ERP_SECRET_KEY=REPLACE
