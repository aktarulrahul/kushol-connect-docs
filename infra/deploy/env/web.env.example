# Kushol Connect web — server environment (copied to /opt/kushol/env/web.env, chmod 600).
# Parsed only by the web repo's src/env.ts. NEXT_PUBLIC_* values are public and are baked into the
# image at build time (web CI build args); these runtime copies must match what the image was built
# with. The browser calls the api same-origin: https://kusholconnect.com/api/v1/… → Nginx → api.

NEXT_PUBLIC_API_URL=https://kusholconnect.com
NEXT_PUBLIC_SITE_URL=https://kusholconnect.com

# 15 · build-time maintenance banner (OPS-BE-015); the Nginx 503 page is the hard gate
NEXT_PUBLIC_MAINTENANCE_MODE=false

# 07 · download links stay disabled until 15 publishes the EAS URLs (WEB-BR-012)
NEXT_PUBLIC_DOWNLOAD_URLS_READY=false
