# 15 · Part B backup/restore targets (ops/backup.sh + ops/restore.sh; root-owned, chmod 600).
# Never commit real values. BACKUP_DATABASE_URL may be a read replica/branch credential — it
# only needs SELECT. RESTORE_DATABASE_URL must be a SCRATCH target, never the live URL.
BACKUP_DATABASE_URL=postgresql://backup_ro:REPLACE@neon-host/kushol?sslmode=require
RESTORE_DATABASE_URL=postgresql://restore:REPLACE@neon-host/kushol_drill?sslmode=require
# postgres client container major ≥ the Neon server's (kushol-connect-db runs Postgres 18)
PG_MAJOR=18
# rclone remotes configured in ~/.config/rclone/rclone.conf (root): R2 S3 backend + off-site
BACKUP_R2_REMOTE=r2
BACKUP_OFFSITE_REMOTE=offsite
